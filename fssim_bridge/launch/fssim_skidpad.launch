<launch>
  <!-- Skidpad needs a mission hint at the crossover: right twice, left twice. -->
  <arg name="use_rviz" default="true" />
  <arg name="cruise_speed" default="1.10" />

  <include file="$(find fssim_bridge)/launch/fssim_integration.launch">
    <arg name="use_rviz" value="$(arg use_rviz)" />
    <arg name="fssim_config" value="$(find fssim)/config/simulation_skidpad.yaml" />
    <arg name="cruise_speed" value="$(arg cruise_speed)" />
    <arg name="minimum_corner_speed" value="0.85" />
    <arg name="lookahead_distance" value="2.0" />
    <arg name="publish_sim_imu" value="true" />
    <arg name="use_mission_turn_hint" value="true" />
    <!-- At the crossover, straight and opposite-turn branches must lose to
         the explicit right/right/left/left mission sequence. -->
    <arg name="mission_wrong_turn_penalty" value="30.0" />
    <arg name="mission_straight_penalty" value="5.0" />
    <arg name="mission_control_use_stop" value="true" />
    <arg name="mission_control_use_speed_limit" value="true" />
    <!-- The generic Delaunay planner is intentionally disabled only for this
         simulator event.  Its crossover has three valid local branches. -->
    <arg name="use_skidpad_path_generator" value="true" />
    <!-- FSSIM skidpad: radial track width is about 3.3 m. The vehicle
         starts 8.9 m before the first usable blue-yellow circle gate. -->
    <arg name="planner_min_width" value="2.7" />
    <arg name="planner_max_width" value="4.3" />
    <arg name="planner_expected_width" value="3.3" />
    <arg name="planner_expected_boundary_spacing" value="3.5" />
    <arg name="planner_start_max_distance" value="10.5" />
    <arg name="planner_max_step_distance" value="4.8" />
    <arg name="planner_allow_orange_cross_edges" value="true" />
  </include>

  <node pkg="scout_mission_manager"
        type="scout_mission_manager_node"
        name="scout_mission_manager"
        output="screen">
    <rosparam command="load"
              file="$(find scout_mission_manager)/config/fssim_skidpad.yaml" />
  </node>
</launch>
