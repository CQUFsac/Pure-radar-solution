  <version>0.1.0</version>
  <description>
    Acceleration and skidpad mission state machine for the SCOUT MINI platform.
  </description>

  <maintainer email="todo@todo.com">CQU FSAC</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

