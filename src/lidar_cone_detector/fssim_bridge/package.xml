<?xml version="1.0"?>
<package format="2">
  <name>fssim_bridge</name>
  <version>0.2.0</version>
  <description>Single integration package for FSSIM cone, odometry, planning and control topics.</description>

  <maintainer email="todo@todo.com">CQU FSAC</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>driverless_msgs</depend>
  <depend>fssim_common</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>roscpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>

  <exec_depend>local_path_planner</exec_depend>
  <exec_depend>rviz</exec_depend>
</package>
