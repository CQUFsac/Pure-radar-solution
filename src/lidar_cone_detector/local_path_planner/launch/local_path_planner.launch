<launch>
  <arg name="input_topic" default="/perception/lidar/cones_raw" />
  <arg name="odometry_topic" default="/odometry/filtered" />
  <arg name="use_odometry" default="true" />
  <arg name="output_topic" default="/planning/local_path" />
  <arg name="expected_frame" default="base_link" />
  <arg name="publish_debug" default="true" />
  <arg name="use_mission_turn_hint" default="false" />
  <arg name="mission_turn_hint_topic" default="/mission/turn_hint" />
  <arg name="edge_min_width" default="1.5" />
  <arg name="edge_expected_width" default="2.5" />
  <arg name="edge_max_width" default="4.5" />

  <node pkg="local_path_planner"
        type="local_path_planner_node"
        name="local_path_planner"
        output="screen">
    <rosparam command="load"
              file="$(find local_path_planner)/config/local_path_planner.yaml" />
    <param name="input_topic" value="$(arg input_topic)" />
    <param name="odometry_topic" value="$(arg odometry_topic)" />
    <param name="use_odometry" value="$(arg use_odometry)" />
    <param name="output_topic" value="$(arg output_topic)" />
    <param name="expected_frame" value="$(arg expected_frame)" />
    <param name="publish_debug" value="$(arg publish_debug)" />
    <param name="mission/use_turn_hint" value="$(arg use_mission_turn_hint)" />
    <param name="mission/turn_hint_topic" value="$(arg mission_turn_hint_topic)" />
    <param name="edge/min_width" value="$(arg edge_min_width)" />
    <param name="edge/expected_width" value="$(arg edge_expected_width)" />
    <param name="edge/max_width" value="$(arg edge_max_width)" />
  </node>
</launch>
