<!--
  scout_straight.launch
  SCOUT MINI 纯雷达 — 直线加速场景

  管线:
    雷达驱动(外部) → lidar_cone_detector → path_generator
    → mode_manager → pure_pursuit → cmd_vel_bridge → /cmd_vel
    + Racing_Loc_Mod 定位

  用法:
    # 先确保雷达驱动和 SCOUT MINI 底盘已启动
    roslaunch cone_car_core scout_straight.launch

  直线加速参数：大前视、高速、不需要急弯模式
-->
<launch>
  <arg name="use_rviz" default="true" />
  <arg name="rviz_config" default="$(find cone_car_core)/config/cone_car.rviz" />

  <!-- ==================== 全局参数（直线加速调参） ==================== -->
  <rosparam file="$(find cone_car_core)/config/params.yaml" command="load" />
  <!-- 覆盖为直线加速参数 -->
  <param name="speed/normal_speed"      value="1.5" />
  <param name="speed/sharp_curve_speed" value="1.0" />
  <param name="mode/sharp_curve_curvature_threshold" value="0.30" />
  <param name="control/lookahead_distance" value="1.0" />
  <param name="control/max_steering_angle" value="0.35" />

  <!-- ==================== 定位层 ==================== -->
  <include file="$(find racing_loc_mod)/launch/localization.launch" />

  <!-- ==================== 感知层（纯雷达） ==================== -->
  <include file="$(find lidar_cone_detector)/launch/lidar_cone_detector.launch">
    <arg name="enable_color_fusion" value="false" />
  </include>

  <!-- ==================== 规划层 ==================== -->
  <node name="path_generator_node" pkg="cone_car_core" type="path_generator_node" output="screen" />

  <!-- ==================== 模式管理层 ==================== -->
  <node name="mode_manager_node" pkg="cone_car_core" type="mode_manager_node" output="screen" />

  <!-- ==================== 控制层 ==================== -->
  <node name="pure_pursuit_controller_node" pkg="cone_car_core" type="pure_pursuit_controller_node" output="screen" />

  <!-- ==================== 控制适配器：ControlCommand → /cmd_vel ==================== -->
  <include file="$(find cmd_vel_bridge)/launch/cmd_vel_bridge.launch">
    <arg name="max_linear_vel"  value="1.5" />
    <arg name="max_angular_vel" value="1.0" />
  </include>

  <!-- ==================== 数据记录 ==================== -->
  <node name="data_logger_node" pkg="cone_car_core" type="data_logger_node" output="screen" />

  <!-- ==================== 可视化 ==================== -->
  <node name="rviz_visualizer_node" pkg="cone_car_core" type="rviz_visualizer_node" output="screen" />
  <group if="$(arg use_rviz)">
    <node name="rviz" pkg="rviz" type="rviz" args="-d $(arg rviz_config)" output="screen" required="false" />
  </group>
</launch>