<!-- 
  simulation_bringup.launch
  仿真/回放模式启动文件：配合 rosbag 回放进行离线调试
  
  与 real_car_bringup.launch 的区别:
    - 不启动雷达驱动 (使用 bag 中的 /velodyne_points)
    - 不启动 YOLO (使用 bag 中的 YOLO 结果或仿真锥桶)
    - use_sim_time = true (使用 bag 时间戳)
    * 使用 fake_cone_publisher 或 bag 中的锥桶话题
    * 使用 fake_vehicle_node 模拟车辆执行
  
  用法:
    # 终端1: 启动系统
    roslaunch cone_car_core simulation_bringup.launch
    
    # 终端2: 回放数据
    rosbag play [double-dash]clock your_recording.bag
    
    可选参数:
      use_fake_perception:=true/false  使用仿真锥桶 (默认 true)
      use_fake_localization:=true/false 使用仿真定位 (默认 false)
      use_rviz:=true/false             启动 RViz (默认 true)
      use_data_logger:=true/false      启动数据记录 (默认 true)
-->
<launch>
  <!-- ==================== Launch Arguments ==================== -->
  <arg name="use_fake_perception"  default="true" />
  <arg name="use_fake_localization" default="false" />
  <arg name="use_rviz"             default="true" />
  <arg name="use_data_logger"      default="true" />
  <arg name="use_fake_vehicle"     default="true" />
  <arg name="rviz_config"          default="$(find cone_car_core)/config/cone_car.rviz" />

  <!-- 关键: 仿真时间同步 -->
  <param name="/use_sim_time" value="true" />

  <!-- ==================== 全局参数加载 ==================== -->
  <rosparam file="$(find cone_car_core)/config/params.yaml" command="load" />

  <!-- ==================== 感知层 ==================== -->
  
  <!-- 仿真模式: 使用 fake_cone_publisher 生成虚拟锥桶 -->
  <group if="$(arg use_fake_perception)">
    <node name="fake_cone_publisher" pkg="cone_car_core" type="fake_cone_publisher" output="screen">
    </node>
  </group>

  <!-- 真实模式: 使用 bag 中的锥桶话题或 fusion 输出 -->
  <group unless="$(arg use_fake_perception)">
    <!-- 多模态融合节点 (如果 bag 中有 YOLO + 点云数据) -->
    <node name="multi_modal_fusion" pkg="multi_modal_fusion" type="fusion_node" output="screen">
      <rosparam command="load" file="$(find multi_modal_fusion)/config/fusion_params.yaml" />
      <remap from="/fusion/cone_array" to="/perception/cones"/>
    </node>

    <!-- Stage-2 MVP 影子定位（只在有真实锥桶感知数据时启动） -->
    <include file="$(find cone_scan_matching_lite)/launch/cone_scan_matching_lite.launch"/>
  </group>

  <!-- ==================== 定位层 ==================== -->
  
  <!-- 仿真模式: 使用 fake_localization (Racing_Loc_Mod) -->
  <group if="$(arg use_fake_localization)">
    <include file="$(find racing_loc_mod)/launch/fake_localization.launch" />
  </group>

  <!-- 真实模式: 使用 LOAM + EKF (如果 bag 中有点云和 IMU 数据) (Racing_Loc_Mod) -->
  <group unless="$(arg use_fake_localization)">
    <include file="$(find racing_loc_mod)/launch/localization.launch" />
  </group>

  <!-- ==================== 规划层 ==================== -->
  <node name="path_generator_node" pkg="cone_car_core" type="path_generator_node" output="screen">
  </node>

  <!-- ==================== 模式管理层 ==================== -->
  <node name="mode_manager_node" pkg="cone_car_core" type="mode_manager_node" output="screen">
  </node>

  <!-- ==================== 控制层 ==================== -->
  <node name="pure_pursuit_controller_node" pkg="cone_car_core" type="pure_pursuit_controller_node" output="screen">
  </node>

  <!-- ==================== 车辆仿真 ==================== -->
  <group if="$(arg use_fake_vehicle)">
    <node name="fake_vehicle_node" pkg="cone_car_core" type="fake_vehicle_node" output="screen">
    </node>
  </group>

  <!-- ==================== 数据记录层 ==================== -->
  <group if="$(arg use_data_logger)">
    <node name="data_logger_node" pkg="cone_car_core" type="data_logger_node" output="screen">
    </node>
  </group>

  <!-- ==================== 可视化层 ==================== -->
  <node name="rviz_visualizer_node" pkg="cone_car_core" type="rviz_visualizer_node" output="screen">
  </node>

  <!-- RViz -->
  <group if="$(arg use_rviz)">
    <node name="rviz" pkg="rviz" type="rviz" args="-d $(arg rviz_config)" output="screen" required="false" />
  </group>
</launch>
