<?xml version="1.0"?>
<package format="2">
  <name>local_path_planner</name>
  <version>1.0.0</version>
  <description>Local cone-track path planner for the SCOUT MINI driverless validation platform.</description>

  <maintainer email="127005873+Zhanccg@users.noreply.github.com">Zhanccg</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>driverless_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>roscpp</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>

  <test_depend>rostest</test_depend>

  <export/>
</package>
